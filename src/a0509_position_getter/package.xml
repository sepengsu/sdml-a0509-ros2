<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a0509_position_getter</name>
  <version>0.1.0</version>
  <description>Position getter for A0509: jogging, posx/posj, save/load, homing (node + Tkinter GUI)</description>
  <maintainer email="na06219@naver.com">jaewon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>dsr_msgs2</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sdml_a0509_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
