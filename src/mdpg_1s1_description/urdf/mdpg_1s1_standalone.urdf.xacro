<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mdpg_1s1_standalone">
  <link name="world"/>
  <xacro:include filename="$(find mdpg_1s1_description)/urdf/mdpg_1s1_macro.xacro"/>
  <xacro:mdpg_1s1_gripper prefix="mdpg_" parent="world">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </xacro:mdpg_1s1_gripper>
</robot>
