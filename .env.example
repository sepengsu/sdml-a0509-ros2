# ======================
# Robot Configuration
# ======================
ROBOT_MODEL=a0509
ROBOT_COLOR=white

# ======================
# Real Mode (Robot Connection)
# ======================
ROBOT_IP=192.168.137.100
ROBOT_RT_IP=192.168.137.100
ROBOT_PORT=12345

# ======================
# Gripper Configuration
# ======================
# Gripper mode: Choose based on your platform
#   - Linux with USB access: Use direct Modbus (GRIPPER_EXTERNAL=false)
#   - Windows/macOS: Use external gripper server (GRIPPER_EXTERNAL=true)
#   - Virtual mode: Use mock (GRIPPER_MOCK=true)

# Serial port for direct Modbus connection (Linux only)
#   Linux: /dev/ttyACM0 or /dev/ttyUSB0
#   Windows: COM3, COM4, etc. (used by gripper server, not container)
#   macOS: /dev/tty.usbmodem* (used by gripper server, not container)
GRIPPER_PORT=/dev/ttyACM0
GRIPPER_BAUDRATE=115200

# External gripper server mode (for Windows/macOS)
# Set to 'true' to use TCP connection to host gripper server
GRIPPER_EXTERNAL=false
GRIPPER_HOST=host.docker.internal
GRIPPER_PORT_TCP=9999

# ======================
# Display (X11/WSLg)
# ======================
DISPLAY=${DISPLAY:-:0}

# ======================
# ROS 2
# ======================
ROS_DOMAIN_ID=29

# ======================
# GPU (optional)
# ======================
# Set to 'true' if using NVIDIA GPU with nvidia-container-toolkit
ENABLE_GPU=false

# ======================
# Auto Launch (optional)
# ======================
# Set to 'true' to automatically start ROS2 launch when container starts
AUTO_LAUNCH=true
LAUNCH_PKG=dsr_bringup2
LAUNCH_FILE=dsr_bringup2_moveit.launch.py
