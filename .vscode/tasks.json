    {
      "label": "ROS2: Launch MoveIt (virtual, robot-emulator)",
      "type": "shell",
      "command": "docker exec -it ros-control bash -lc \"ros2 launch dsr_bringup2 dsr_bringup2_moveit.launch.py model:=a0509 mode:=virtual host:=robot-emulator rt_host:=robot-emulator port:=12345\"",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Launch SDML Bringup (virtual, run --rm)",
      "type": "shell",
      "command": "docker compose --profile virtual run --rm ros-control bash -lc \"cd /ros2_ws && source /opt/ros/humble/setup.bash && source install/setup.bash && ros2 launch sdml_a0509_bringup a0509_virtual.launch.py host:=robot-emulator rt_host:=robot-emulator\"",
      "group": "none",
      "presentation": {
        "reveal": "always",
