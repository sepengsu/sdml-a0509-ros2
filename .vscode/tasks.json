{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Build",
      "type": "shell",
      "command": "docker compose --profile virtual build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Up (Virtual - Emulator)",
      "type": "shell",
      "command": "docker compose --profile virtual up --build",
