FROM osrf/ros:humble-desktop

# Improve apt stability against transient mirror/repo errors
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries

# Install dependencies (from existing devcontainer)
RUN rm -rf /var/lib/apt/lists/* && apt-get update && apt-get install -y --no-install-recommends \
    libpoco-dev libyaml-cpp-dev dbus-x11 libmodbus-dev \
    ros-humble-control-msgs ros-humble-realtime-tools ros-humble-xacro \
    ros-humble-joint-state-publisher-gui ros-humble-ros2-control \
    ros-humble-ros2-controllers ros-humble-gazebo-msgs ros-humble-moveit-msgs \
    ros-humble-gazebo-ros-pkgs ros-humble-ros-gz-sim ros-humble-moveit \
    ros-humble-ign-ros2-control \
    ros-humble-rosbridge-suite \
    ros-humble-topic-tools \
    ros-humble-cv-bridge \
    python3-opencv \
    python3-pip python3-websocket vim curl \
    ca-certificates gnupg2 lsb-release \
    iputils-ping netcat-openbsd iproute2 \
    xvfb x11vnc novnc websockify supervisor \
    fluxbox xterm \
    && rm -rf /var/lib/apt/lists/*

# Intel RealSense SDK apt repository
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xFB0B24895113F120" | \
    gpg --dearmor -o /etc/apt/keyrings/librealsense.pgp && \
    echo "deb [signed-by=/etc/apt/keyrings/librealsense.pgp] https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/librealsense.list

# RealSense ROS 2 packages + RealSense SDK userspace tools/libraries
RUN rm -rf /var/lib/apt/lists/* && apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-realsense2-camera \
    ros-humble-realsense2-description \
    librealsense2-utils \
    librealsense2-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup noVNC
RUN ln -s /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# Create non-root user
ARG USERNAME=robot
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Create minimal Fluxbox menu (right-click menu for launching apps)
RUN mkdir -p /home/$USERNAME/.fluxbox && \
    echo '[begin] (Fluxbox)' > /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (Terminal) {xterm}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (RViz2) {rviz2}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (RQt) {rqt}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '[end]' >> /home/$USERNAME/.fluxbox/menu && \
    chown -R $USER_UID:$USER_GID /home/$USERNAME/.fluxbox

# Setup workspace
WORKDIR /ros2_ws
RUN mkdir -p /ros2_ws/src /ros2_ws/build /ros2_ws/install /ros2_ws/log && \
    chown -R $USER_UID:$USER_GID /ros2_ws
ENV ROS_DOMAIN_ID=29

# Add ROS 2 sourcing to bashrc for interactive shells (docker exec)
RUN echo "source /opt/ros/humble/setup.bash" >> /home/$USERNAME/.bashrc && \
    echo "if [ -f /ros2_ws/install/setup.bash ]; then source /ros2_ws/install/setup.bash; fi" >> /home/$USERNAME/.bashrc

# VNC startup script (with CRLF fix for Windows compatibility)
COPY docker/start-vnc.sh /start-vnc.sh
RUN sed -i 's/\r$//' /start-vnc.sh && chmod +x /start-vnc.sh

# Entrypoint (with CRLF fix for Windows compatibility)
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

USER $USERNAME
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
