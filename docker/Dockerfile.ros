FROM osrf/ros:humble-desktop

# Install dependencies (from existing devcontainer)
RUN apt-get update && apt-get install -y \
    libpoco-dev libyaml-cpp-dev dbus-x11 libmodbus-dev libglfw3-dev libeigen3-dev \
    ros-humble-control-msgs ros-humble-realtime-tools ros-humble-xacro \
    ros-humble-joint-state-publisher-gui ros-humble-ros2-control \
    ros-humble-ros2-controllers ros-humble-gazebo-msgs ros-humble-moveit-msgs \
    ros-humble-gazebo-ros-pkgs ros-humble-ros-gz-sim ros-humble-moveit \
    ros-humble-ign-ros2-control \
    python3-pip python3-colcon-common-extensions ros-humble-rosbag2 vim curl \
    iputils-ping netcat-openbsd iproute2 \
    xvfb x11vnc novnc websockify supervisor \
    fluxbox xterm \
    && rm -rf /var/lib/apt/lists/*

# MuJoCo C++ distribution for the pinned mujoco_ros2_control submodule.
# The Python package is used by the experiment's independent IK/dynamics observer.
ARG MUJOCO_VERSION=3.2.7
ENV MUJOCO_DIR=/opt/mujoco/mujoco-${MUJOCO_VERSION}
ENV LD_LIBRARY_PATH=${MUJOCO_DIR}/lib
RUN mkdir -p /opt/mujoco && \
    curl -fL "https://github.com/google-deepmind/mujoco/releases/download/${MUJOCO_VERSION}/mujoco-${MUJOCO_VERSION}-linux-x86_64.tar.gz" \
      | tar -xz -C /opt/mujoco && \
    python3 -m pip install --no-cache-dir "mujoco==${MUJOCO_VERSION}" matplotlib numpy PyYAML mss imageio-ffmpeg fast-simplification

# Setup noVNC
RUN ln -s /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# Create non-root user
ARG USERNAME=robot
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Create minimal Fluxbox menu (right-click menu for launching apps)
RUN mkdir -p /home/$USERNAME/.fluxbox && \
    echo '[begin] (Fluxbox)' > /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (Terminal) {xterm}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (RViz2) {rviz2}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '  [exec] (RQt) {rqt}' >> /home/$USERNAME/.fluxbox/menu && \
    echo '[end]' >> /home/$USERNAME/.fluxbox/menu && \
    chown -R $USER_UID:$USER_GID /home/$USERNAME/.fluxbox

# Setup workspace
WORKDIR /ros2_ws
RUN mkdir -p /ros2_ws/src /ros2_ws/build /ros2_ws/install /ros2_ws/log && \
    chown -R $USER_UID:$USER_GID /ros2_ws
ENV ROS_DOMAIN_ID=29

# Add ROS 2 sourcing to bashrc for interactive shells (docker exec)
RUN echo "source /opt/ros/humble/setup.bash" >> /home/$USERNAME/.bashrc && \
    echo "if [ -f /ros2_ws/install/setup.bash ]; then source /ros2_ws/install/setup.bash; fi" >> /home/$USERNAME/.bashrc

# VNC startup script (with CRLF fix for Windows compatibility)
COPY docker/start-vnc.sh /start-vnc.sh
RUN sed -i 's/\r$//' /start-vnc.sh && chmod +x /start-vnc.sh

# Entrypoint (with CRLF fix for Windows compatibility)
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

USER $USERNAME
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
